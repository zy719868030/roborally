<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>


<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.lmu.dbs.ifi.sep25.ui.GameController">

    <HBox spacing="30" styleClass="root-background">


    <!-- === Linke Seitenleiste: Spielerstatus + Chat === -->
    <VBox fx:id="leftSidebar" spacing="15" alignment="TOP_CENTER" styleClass="lobby-box" VBox.vgrow="ALWAYS">

        <!-- Spielfeld-Label oder Spielstatus -->
        <HBox fx:id="turnInfoBox" spacing="10" alignment="CENTER_LEFT">
            <ImageView fx:id="playerIcon" fitHeight="60" fitWidth="60" preserveRatio="true"/>
            <Label fx:id="statusLabel" text="Spiel läuft..." styleClass="dynamic-status"/>
        </HBox>

        <!-- Spielerstatus Panel -->
        <VBox fx:id="playerStatusBox" spacing="8" alignment="TOP_LEFT"
              style="-fx-background-color: #33cccc22; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;"
              prefWidth="220" maxHeight="300">
            <Label text="Spielerstatus" style="-fx-font-weight: bold; -fx-text-fill: #007777; -fx-font-size: 14px;" />

        </VBox>
        <!-- Energieleiste -->
        <HBox fx:id="energyBox"
              spacing="10"
              alignment="CENTER_LEFT"
              visible="false"
              managed="false"
              styleClass="energy-box">
            <Label fx:id="energyIcon"
                   text="⚡"
                   styleClass="energy-icon" />

            <ProgressBar fx:id="energyBar"
                         prefWidth="160"
                         prefHeight="16"
                         styleClass="energy-bar" />

            <Label fx:id="energyValue"
                   text="5"
                   styleClass="energy-value" />
        </HBox>

        <Region prefHeight="10"/>
        <Button fx:id="notificationsToggleButton"
                onAction="#toggleNotificationsPanel"
                styleClass="button-dorado"
                prefWidth="200" prefHeight="60">
            <tooltip>
                <Tooltip text="Spielmeldungen anzeigen"/>
            </tooltip>
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                        <image>
                            <Image url="/assets/roborally_log.png"/>
                        </image>
                    </ImageView>
                    <Label fx:id="notificationIconLabel"
                           text="▼"
                           styleClass="label-dorado"
                           translateY="-6"/>
                </HBox>
            </graphic>
        </Button>
        <!-- Game Log Panel -->
        <VBox fx:id="gameLogContainer"
              onMouseEntered="#expandGameLog"
              onMouseExited="#collapseGameLog"
              maxWidth="300"
              spacing="5">

            <!-- 🔹 Siempre visible: muestra el último mensaje -->
            <Label fx:id="gameLogCompactLabel"
                   styleClass="game-log-compact"
                   text="System bereit..."
                   maxWidth="300"
                   wrapText="true" />

            <!-- 🔹 Historial solo visible al pasar el mouse -->
            <ScrollPane fx:id="gameLogScrollPane"
                        visible="false"
                        managed="false"
                        fitToWidth="true"
                        vbarPolicy="AS_NEEDED"
                        styleClass="log-scroll-pane"
                        prefHeight="120"
                        prefWidth="300">
                <VBox fx:id="gameLogArea"
                      styleClass="game-log-area"
                      spacing="4"
                      alignment="TOP_LEFT"
                      prefWidth="280"/>
            </ScrollPane>
        </VBox>




        <!-- Chat Minimieren -->
        <Button fx:id="chatToggleButton"
                onAction="#toggleChatBox"
                styleClass="button-dorado"
                prefWidth="200" prefHeight="60">
            <tooltip>
                <Tooltip text="Chat ausblenden"/>
            </tooltip>
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                        <image>
                            <Image url="/assets/chat_lobby1.png"/>
                        </image>
                    </ImageView>
                    <Label fx:id="chatIconLabel"
                           text="▼"
                           styleClass="label-dorado"
                           translateY="-6"/>
                </HBox>
            </graphic>
        </Button>
        <!-- === Chat-Box === -->
        <VBox fx:id="chatBox" spacing="10" alignment="TOP_CENTER">
            <TextArea fx:id="chatArea" styleClass="chat-area" editable="false" wrapText="true" prefHeight="200"
                      prefWidth="300"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="chatInput" styleClass="chat-input" promptText="Nachricht eingeben..."
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="recipientBox" promptText="An..." prefWidth="100" styleClass="combo-recipient"/>
                <Button text="Senden" onAction="#handleSendChat" styleClass="senden-button"/>
            </HBox>
            <StackPane fx:id="popupContainer" visible="false" managed="false" style="-fx-padding: 5;"/>
        </VBox>
    </VBox>

    <!-- Miniatur-Icons für Restore Chat -->
    <HBox fx:id="iconMenu" spacing="5" alignment="BOTTOM_LEFT"
          visible="false" managed="false">
        <Button fx:id="chatRestoreButton"
                onAction="#toggleChatBox"
                styleClass="neon-thumbnail"
                prefWidth="240" prefHeight="60">
            <tooltip>
                <Tooltip text="Chat anzeigen"/>
            </tooltip>
            <graphic>
                <ImageView fitHeight="60" fitWidth="240" preserveRatio="true">
                    <image>
                        <Image url="/assets/chat_lobby1.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- === Rechte Seite: Spielfeld & Kartenbereich === -->
    <StackPane alignment="TOP_LEFT" HBox.hgrow="ALWAYS">

        <VBox spacing="10" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
            <!-- Phase & Timer -->
            <Label fx:id="phaseLabel" text="Phase: Vorbereitung" styleClass="status-label"/>
            <Label fx:id="timerLabel" text="Zeit: 30s" styleClass="countdown-label" visible="false" managed="false"/>

            <!-- Spielfeld -->
            <ScrollPane fx:id="gameBoardScrollPane"
                        fitToWidth="false"
                        fitToHeight="false"
                        style="-fx-background-color: transparent;"
                        prefViewportWidth="1000"
                        prefViewportHeight="800"
                        VBox.vgrow="NEVER">
                <StackPane fx:id="scrollContentWrapper" alignment="CENTER">
                    <StackPane fx:id="zoomWrapper"
                               alignment="CENTER"
                               style="-fx-background-color: transparent;"
                               minWidth="1200"
                               minHeight="900">

                      <Group fx:id="zoomContent">
                        <GridPane fx:id="gameBoardPane"
                                  hgap="0"
                                  vgap="0"
                                  alignment="CENTER"
                                  maxWidth="-1"/>
                      </Group>
                        <Pane fx:id="laserLayer"
                              pickOnBounds="false"
                              mouseTransparent="true"
                              minWidth="1200"
                              minHeight="900"
                              StackPane.alignment="TOP_LEFT" />
                        <ImageView fx:id="gameLogoView"
                                   fitHeight="250" fitWidth="600"
                                   visible="false" managed="false"
                                   preserveRatio="true"
                                   StackPane.alignment="CENTER"
                                   styleClass="logo-glow">
                            <image>
                                <Image url="/assets/roborally_log.png"/>
                            </image>
                        </ImageView>

                    </StackPane>
                </StackPane>
            </ScrollPane>

            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
                <HBox fx:id="handCardBox" spacing="10" alignment="CENTER"/>
                <Button text="Mischen"
                        fx:id="shuffleVisualButton"
                        onAction="#handleShuffleVisual"
                        styleClass="senden-button"
                        prefWidth="100" prefHeight="40"
                        visible="false" managed="false"/>
            </HBox>

            <!-- Register + Ablage -->
            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" spacing="5">
                    <StackPane fx:id="discardPileBox" prefWidth="60" prefHeight="90"
                               style="-fx-padding: 5; -fx-border-color: gray; -fx-background-color: #222;">
                        <Label text="Ablage"
                               style="-fx-text-fill: #00ffff; -fx-font-size: 12px; -fx-font-weight: bold;"
                               StackPane.alignment="CENTER"/>
                        <Label fx:id="discardCountLabel" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"
                               StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>
                </VBox>

                <HBox fx:id="registerBox" spacing="10" alignment="CENTER" style="-fx-padding: 10;"/>
            </HBox>

            <!-- Bestätigen -->
            <Button text="Bestätigen" fx:id="confirmSelectionButton"
                    onAction="#handleConfirmSelection"
                    styleClass="senden-button"
                    prefWidth="180" prefHeight="50"/>

            <HBox fx:id="playedCardsBox" spacing="5" alignment="CENTER" style="-fx-padding: 5;"/>
        </VBox>

        <HBox spacing="6" alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT" style="-fx-padding: 10;" pickOnBounds="false">
            <Button fx:id="zoomInButton"
                    onAction="#handleZoomIn"
                    styleClass="senden-button"
                    prefWidth="20" prefHeight="20"
                    maxWidth="40" maxHeight="40"
                    pickOnBounds="true">
                <graphic>
                    <ImageView fitHeight="40" fitWidth="40" preserveRatio="true" mouseTransparent="true">
                        <image>
                            <Image url="/assets/icon_loupe_in.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="zoomOutButton"
                    onAction="#handleZoomOut"
                    styleClass="senden-button"
                    prefWidth="20" prefHeight="20"
                    maxWidth="40" maxHeight="40"
                    pickOnBounds="true">
                <graphic>
                    <ImageView fitHeight="40" fitWidth="40" preserveRatio="true" mouseTransparent="true">
                        <image>
                            <Image url="/assets/icon_loupe_out.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>

        </HBox>

    </StackPane>
</HBox>

</StackPane>

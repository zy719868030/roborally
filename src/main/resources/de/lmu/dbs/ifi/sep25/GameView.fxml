<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:controller="de.lmu.dbs.ifi.sep25.ui.GameController"
            xmlns:fx="http://javafx.com/fxml" prefWidth="1200" prefHeight="800">

    <!-- SPIELFELD-MITTE -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <GridPane fx:id="gameBoardPane" hgap="0" vgap="0" />
        </ScrollPane>
    </center>

    <!-- RECHTE SEITE: Status + Chat -->
    <right>
        <VBox spacing="10" padding="10 10 10 10">
            <Label fx:id="statusLabel" text="Spiel läuft..." />
            <Separator/>

            <!-- CHAT -->
            <Label text="Chat:"/>
            <TextArea fx:id="chatArea" prefRowCount="10" editable="false" wrapText="true"/>
            <HBox spacing="5">
                <TextField fx:id="chatInput" HBox.hgrow="ALWAYS"/>
                <Button text="Senden" onAction="#handleSendChat"/>
            </HBox>
        </VBox>
    </right>

</BorderPane>


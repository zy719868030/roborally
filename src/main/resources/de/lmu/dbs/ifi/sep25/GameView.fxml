<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Group?>


<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.lmu.dbs.ifi.sep25.ui.GameController"
      spacing="30" styleClass="root-background">


    <!-- === Linke Seitenleiste: Spielerstatus + Chat === -->
    <VBox fx:id="leftSidebar" spacing="15" alignment="TOP_CENTER" styleClass="lobby-box" VBox.vgrow="ALWAYS">

        <!-- Spielfeld-Label oder Spielstatus -->
        <HBox fx:id="turnInfoBox" spacing="10" alignment="CENTER_LEFT">
            <ImageView fx:id="playerIcon" fitHeight="60" fitWidth="60" preserveRatio="true"/>
            <Label fx:id="statusLabel" text="Spiel läuft..." styleClass="dynamic-status"/>
        </HBox>

        <!-- Spielerstatus Panel -->
        <VBox fx:id="playerStatusBox" spacing="8" alignment="TOP_LEFT"
              style="-fx-background-color: #33cccc22; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;"
              prefWidth="220" maxHeight="300">
            <Label text="Spielerstatus" style="-fx-font-weight: bold; -fx-text-fill: #007777; -fx-font-size: 14px;" />
            <!-- Dynamisch gefüllt durch GameController -->
        </VBox>
        <!-- Energieleiste -->
        <HBox fx:id="energyBox" spacing="5" alignment="CENTER_LEFT"
              visible="false" managed="false"
              style="-fx-padding: 5;">
            <Label text="⚡" fx:id="energyIcon" style="-fx-font-size: 16px;" />
            <ProgressBar fx:id="energyBar" prefWidth="150" progress="1.0" />
            <Label fx:id="energyValue" text="5" />
        </HBox>
        <!-- Chat Minimieren -->
        <Button fx:id="chatToggleButton"
                onAction="#toggleChatBox"
                styleClass="button-dorado"
                prefWidth="200" prefHeight="60">
            <tooltip>
                <Tooltip text="Chat ausblenden"/>
            </tooltip>
            <graphic>
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                        <image>
                            <Image url="/assets/chat_lobby1.png"/>
                        </image>
                    </ImageView>
                    <Label fx:id="chatIconLabel"
                           text="▼"
                           styleClass="label-dorado"
                           translateY="-6"/>
                </HBox>
            </graphic>
        </Button>
        <!-- === Chat-Box === -->
        <VBox fx:id="chatBox" spacing="10" alignment="TOP_CENTER">
            <TextArea fx:id="chatArea" styleClass="chat-area" editable="false" wrapText="true" prefHeight="200"
                      prefWidth="300"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="chatInput" styleClass="chat-input" promptText="Nachricht eingeben..."
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="recipientBox" promptText="An..." prefWidth="100" styleClass="combo-recipient"/>
                <Button text="Senden" onAction="#handleSendChat" styleClass="senden-button"/>
            </HBox>
            <StackPane fx:id="popupContainer" visible="false" managed="false" style="-fx-padding: 5;"/>
        </VBox>
    </VBox>

    <!-- Miniatur-Icons für Restore (z. B. Chat) – gehört hier rein -->
    <HBox fx:id="iconMenu" spacing="5" alignment="BOTTOM_LEFT"
          visible="false" managed="false">
        <Button fx:id="chatRestoreButton"
                onAction="#toggleChatBox"
                styleClass="neon-thumbnail"
                prefWidth="240" prefHeight="60">
            <tooltip>
                <Tooltip text="Chat anzeigen"/>
            </tooltip>
            <graphic>
                <ImageView fitHeight="60" fitWidth="240" preserveRatio="true">
                    <image>
                        <Image url="/assets/chat_lobby1.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- === Rechte Seite: Spielfeld & Kartenbereich === -->
    <VBox spacing="10" alignment="TOP_CENTER">

        <!--  PHASE-ANZEIGE -->
        <Label fx:id="phaseLabel"
               text="Phase: Vorbereitung"
               styleClass="status-label"/>

        <!--  TIMER LABEL -->
        <Label fx:id="timerLabel"
               text="Zeit: 30s"
               styleClass="countdown-label"
               visible="false"
               managed="false"/> <!-- damit auch kein Platz reserviert wird -->
        <!-- Spielfeld -->
        <ScrollPane fx:id="gameBoardScrollPane"
                    fitToWidth="false"
                    fitToHeight="false"
                    style="-fx-background-color: transparent;">
            <Group>
                <StackPane fx:id="zoomWrapper" style="-fx-background-color: transparent;">
                    <GridPane fx:id="gameBoardPane" hgap="0" vgap="0"/>
                    <!-- ROBOLOGO  -->
                    <ImageView fx:id="gameLogoView"
                               fitHeight="250" fitWidth="600"
                               visible="false" managed="false"
                               preserveRatio="true"
                               StackPane.alignment="CENTER"
                               styleClass="logo-glow">
                        <image>
                            <Image url="/assets/roborally_log.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </Group>
        </ScrollPane>



        <!-- Handkartenbereich -->
        <HBox fx:id="handCardBox" spacing="10" alignment="CENTER" style="-fx-padding: 10;"/>
        <!-- Register + Discard-Pile kombiniert -->
        <HBox spacing="20" alignment="CENTER">
            <!-- Ablagestapel links -->
            <VBox alignment="CENTER" spacing="5">
                <StackPane fx:id="discardPileBox"
                           prefWidth="60" prefHeight="90"
                           style="-fx-padding: 5; -fx-border-color: gray; -fx-background-color: #222;">
                    <!-- Si no hay carta, esto se ve -->
                    <Label text="Ablage"
                           style="-fx-text-fill: #00ffff; -fx-font-size: 12px; -fx-font-weight: bold;"
                           StackPane.alignment="CENTER"/>
                </StackPane>

            </VBox>

            <!-- Register-Bereich für 5 ausgewählte Karten -->
            <HBox fx:id="registerBox"
                  spacing="10"
                  alignment="CENTER"
                  style="-fx-padding: 10;">
            </HBox>
        </HBox>


        <!-- Bestätigungs-Button -->
        <Button text="Bestätigen"
                fx:id="confirmSelectionButton"
                onAction="#handleConfirmSelection"
                styleClass="senden-button"
                prefWidth="180" prefHeight="50"/>


        <!-- Gespielte Karten -->
        <HBox fx:id="playedCardsBox" spacing="5" alignment="CENTER" style="-fx-padding: 5;"/>



    </VBox>

</HBox>

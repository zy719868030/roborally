<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>

<ScrollPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.lmu.dbs.ifi.sep25.ui.LobbyController"
      fitToWidth="true"
      fitToHeight="true"
      styleClass="root-background">

    <HBox spacing="30" styleClass="root-background" minWidth="1200" minHeight="900">

        <!-- === Linke Seite: Spieler + Auswahl + Lobby === -->
        <VBox fx:id="lobbyBox" spacing="15" alignment="TOP_CENTER" styleClass="lobby-box">

            <!-- Bild als Minimierungs-Knopf -->
            <Button fx:id="lobbyToggleButton"
                    onAction="#toggleLobbyBox"
                    styleClass="button-neon-cyan"
                    prefWidth="320" prefHeight="80">
                <tooltip>
                    <Tooltip text="Lobby verstecken"/>
                </tooltip>
                <graphic>
                    <HBox alignment="CENTER" spacing="10">
                        <ImageView fitHeight="80" fitWidth="240" preserveRatio="true">
                            <image>
                                <Image url="/assets/lobby_tittle.png"/>
                            </image>
                        </ImageView>
                        <Label fx:id="lobbyIconLabel"
                               text="▼"
                               styleClass="label-dorado"/>

                    </HBox>
                </graphic>
            </Button>
            <ListView fx:id="playerList" prefHeight="200" prefWidth="300" styleClass="lobby-list"/>

            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="statusLabel" text="Status..." styleClass="status-label"/>
                <VBox alignment="CENTER" spacing="5">
                    <Button fx:id="readyButton" text="Bereit" onAction="#handleReady" styleClass="ready-button" prefWidth="150" prefHeight="40"/>
                    <Button fx:id="notReadyButton" text="Nicht bereit" onAction="#handleNotReady"
                            styleClass="not-ready-button" visible="false" managed="false" prefWidth="150" prefHeight="40"/>
                </VBox>

                <Region prefHeight="3"/>
                <VBox fx:id="mapSelectionBox" spacing="10" alignment="CENTER" visible="false" managed="false">
                    <ComboBox fx:id="mapChoiceBox" promptText="Karte wählen..." prefWidth="150" styleClass="combo-recipient"/>
                    <Button fx:id="selectMapButton" text="Karte wählen" onAction="#handleMapSelection" styleClass="senden-button"
                            prefWidth="130" prefHeight="36"/>
                </VBox>


                <!-- === ChatBox + Minimierungsbutton === -->
                <VBox spacing="5" alignment="TOP_CENTER">
                    <Button fx:id="chatToggleButton"
                            onAction="#toggleChatBox"
                            styleClass="button-dorado"
                            prefWidth="200" prefHeight="60">
                        <tooltip>
                            <Tooltip text="Chat verstecken"/>
                        </tooltip>
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <ImageView fitHeight="60" fitWidth="160" preserveRatio="true">
                                    <image>
                                        <Image url="/assets/chat_lobby1.png"/>
                                    </image>
                                </ImageView>
                                <Label fx:id="chatIconLabel"
                                       text="▼"
                                       styleClass="label-dorado"
                                       translateY="-6"/>

                            </HBox>
                        </graphic>
                    </Button>
                    <VBox fx:id="chatBox" spacing="10" alignment="TOP_CENTER">
                        <TextArea fx:id="chatArea" styleClass="chat-area" editable="false" wrapText="true" prefHeight="200" prefWidth="300"/>
                        <HBox spacing="10" alignment="CENTER">
                            <TextField fx:id="chatInput" styleClass="chat-input" promptText="Nachricht eingeben..." HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="recipientBox" promptText="An..." prefWidth="100" styleClass="combo-recipient"/>
                            <Button text="Senden" onAction="#handleSendChat" styleClass="senden-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
        <!-- === Rechte Seite: Spielfeld + Map-Vorschau === -->
        <VBox spacing="10" alignment="TOP_CENTER">
            <Label text="Spielfeld Vorschau" styleClass="status-label" />
            <Label fx:id="mapLabel" text="Noch keine Karte gewählt." styleClass="sourcetext"/>
                <StackPane fx:id="mapPreviewContainer"
                           alignment="CENTER"
                           prefWidth="800"
                           prefHeight="600"
                           maxWidth="800"
                           maxHeight="600">
                    <ImageView fx:id="mapPreviewImage"
                               preserveRatio="true"
                               smooth="true"
                               visible="false"
                               managed="false"
                               fitWidth="780"
                               fitHeight="580" />
                </StackPane>



        </VBox>

        <!-- === Miniatur-Icons unten zum Wiederherstellen === -->
        <VBox spacing="5" alignment="BOTTOM_CENTER">
            <HBox fx:id="iconMenu" spacing="5" alignment="CENTER"
                  visible="false" managed="false">
                <Button fx:id="lobbyRestoreButton"
                        onAction="#toggleLobbyBox"
                        styleClass="neon-thumbnail"
                        prefWidth="240" prefHeight="60">
                    <tooltip><Tooltip text="Lobby anzeigen"/></tooltip>
                    <graphic>
                        <ImageView fitHeight="40" fitWidth="160" preserveRatio="true">
                            <image>
                                <Image url="/assets/lobby_tittle.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="chatRestoreButton"
                        onAction="#toggleChatBox"
                        styleClass="neon-thumbnail"
                        prefWidth="240" prefHeight="60">
                    <tooltip><Tooltip text="Chat anzeigen"/></tooltip>
                    <graphic>
                        <ImageView fitHeight="60" fitWidth="240" preserveRatio="true">
                            <image>
                                <Image url="/assets/chat_lobby1.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</ScrollPane>

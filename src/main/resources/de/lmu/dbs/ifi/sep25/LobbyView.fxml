<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.lmu.dbs.ifi.sep25.ui.LobbyController"
      spacing="30" style="-fx-padding: 20">

    <!-- === Linke Seite: Spieler + Auswahl + Chat === -->
    <VBox spacing="15" alignment="TOP_CENTER">

        <Label text="Lobby – Spielerübersicht" style="-fx-font-size: 18px;" />
        <ListView fx:id="playerList" prefHeight="200" prefWidth="300"/>

        <!-- === Status, Buttons & Kartenwahl zusammengefasst === -->
        <VBox spacing="10" alignment="CENTER">

            <!-- Status + Buttons -->
            <Label fx:id="statusLabel" text="Status..." />

            <!-- Block: Buttons -->
            <StackPane alignment="CENTER">
                <Button fx:id="readyButton" text="Bereit" onAction="#handleReady" styleClass="ready-button"/>
                <Button fx:id="notReadyButton" text="Nicht bereit" onAction="#handleNotReady"
                        styleClass="not-ready-button" visible="false" managed="false"/>
            </StackPane>

            <!-- Block: Kartenwahl extra -->
            <VBox fx:id="mapSelectionBox" spacing="10" alignment="CENTER" visible="false" managed="false">
                <ComboBox fx:id="mapChoiceBox" promptText="Karte wählen..." prefWidth="150"/>
                <Button fx:id="selectMapButton" text="Karte wählen" onAction="#handleMapSelection"/>
            </VBox>

        </VBox>

        <Separator prefWidth="300"/>
        <Label text="Chat" style="-fx-font-size: 16px;" />
        <TextArea fx:id="chatArea" editable="false" wrapText="true" prefHeight="200" prefWidth="300"/>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="chatInput" promptText="Nachricht eingeben..." HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="recipientBox" promptText="An..." prefWidth="100"/>
            <Button text="Senden" onAction="#handleSendChat"/>
        </HBox>
    </VBox>

    <!-- === Rechte Seite: Spielfeld + Map-Vorschau === -->
    <VBox spacing="10" alignment="TOP_CENTER">
        <Label text="Spielfeld" style="-fx-font-size: 16px;" />
        <Label fx:id="mapLabel" text="Noch keine Karte gewählt." />
        <StackPane fx:id="mapPreviewContainer" prefWidth="300" prefHeight="300" maxWidth="Infinity" maxHeight="Infinity">            <ImageView fx:id="mapPreviewImage"
                       preserveRatio="true"
                       smooth="true"
                       fitWidth="Infinity"
                       fitHeight="Infinity"
                       visible="false"
                       managed="false"/>
        </StackPane>
        <GridPane fx:id="gameBoardPane" visible="true" managed="true"/>
    </VBox>
</HBox>

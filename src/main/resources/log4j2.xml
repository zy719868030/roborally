<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Console (optional) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>

        <!-- Main application log -->
        <File name="AppFile" fileName="logs/app.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </File>

        <!-- Dedicated message log -->
        <File name="MessageFile" fileName="logs/messages.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </File>

        <!-- Error log -->
        <File name="ErrorFile" fileName="logs/errors.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
            <Filters>
                <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
        </File>

        <!-- Alive log -->
        <RollingFile name="HeartbeatFile"
                     fileName="logs/heartbeat.log"
                     filePattern="logs/heartbeat-%d{yyyy-MM-dd}.log.gz"
                     append="false">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- Server communication log -->
        <File name="ServerCommFile" fileName="logs/server_comm.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        </File>

        <!-- Per-client routing appender -->
        <Routing name="ClientRouting">
            <Routes pattern="$${ctx:clientId}">
                <Route key="*">
                    <File name="PerClientFile" fileName="logs/client-${ctx:clientId}.log" append="false">
                        <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %logger{36} - %msg%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <!-- Logger for message I/O -->
        <Logger name="MessageLogger" level="info" additivity="false">
            <AppenderRef ref="MessageFile"/>
        </Logger>

        <!-- Logger for server-side communication -->
        <Logger name="ServerCommLogger" level="info" additivity="false">
            <AppenderRef ref="ServerCommFile"/>
<!--            <AppenderRef ref ="Console" />-->
        </Logger>

        <!-- Logger for per-client routing -->
        <Logger name="PerClientLogger" level="info">
            <AppenderRef ref="ClientRouting"/>
        </Logger>

        <!-- Logger for errors -->
        <Logger name="ErrorLogger" level="error" additivity="false">
            <AppenderRef ref="ErrorFile"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Logger for alive checks -->
        <Logger name="heartbeatLogger" level="info" additivity="false">
            <AppenderRef ref="HeartbeatFile"/>
        </Logger>

        <!-- Root logger for everything else -->
        <Root level="info">
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="Console"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>
